{
  "name": "homebase",
  "private": true,
  "version": "0.1.0",
  "description": "HOMEBASE — a private family home screen for a wall display and parents' phones. Picture-led for children who cannot read yet.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/standalone.ts",
    "preview": "tsx server/standalone.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "HOMEBASE_TEST_PG=1 vitest run --project server",
    "test:e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate && tsx scripts/embed-migrations.ts",
    "db:embed": "tsx scripts/embed-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-local.ts",
    "admin": "tsx scripts/admin.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "screens": "tsx scripts/capture-screens.ts",
    "measure": "tsx scripts/measure-wall.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource/andika": "5.3.0",
    "@hono/node-server": "2.1.11",
    "@vercel/functions": "3.11.4",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.22",
    "idb": "8.0.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
