# HOMEBASE environment. Copy to .env for local use. NEVER commit real values.
# With nothing set, `npm run dev` runs against a local database file in .data/ with a made-up family.

# --- Database -------------------------------------------------------------------------------
# A Postgres connection string (the pooled one, on Supabase or Neon). Leave unset to use the local file database.
DATABASE_URL=
# Set to "require" for hosted Postgres that needs TLS and does not say so in the URL.
# HOMEBASE_DB_SSL=require

# --- Mode -----------------------------------------------------------------------------------
# "1" fills an empty database with the made-up Maple Street family and offers one-tap demo sign-in.
# Never set this on a deployment that holds a real family's data.
HOMEBASE_DEMO=

# --- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
# Encrypts stored connection secrets (calendar links). Required before any integration is connected.
HOMEBASE_SECRET_KEY=
# Sent by the scheduler with the daily housekeeping call.
CRON_SECRET=

# --- Sign-up --------------------------------------------------------------------------------
# The first family to sign up owns the deployment. Set to "1" only if more families should be able to join.
HOMEBASE_OPEN_SIGNUP=

# --- Training Academy -----------------------------------------------------------------------
# Extra hosts the Academy may be opened at (comma-separated), beyond its public address. For a preview or a
# local copy, for example: localhost,my-academy-preview.vercel.app
HOMEBASE_ACADEMY_HOSTS=

# --- Weather (only for households that switch it on in Settings; see docs/integrations/WEATHER.md) ---
# "auto" (the default) asks the US National Weather Service inside the US and Open-Meteo elsewhere; "nws",
# "open-meteo", or "off" to never ask any weather service.
HOMEBASE_WEATHER=

# --- Photos ---------------------------------------------------------------------------------
# How many megabytes of family photos one household may keep in the database (all sizes counted). Default 200.
HOMEBASE_MEDIA_LIMIT_MB=

# --- Optional AI (off unless a key is present AND a guardian switches it on in Settings) -----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# HOMEBASE_AI_ANTHROPIC_MODEL=
# HOMEBASE_AI_OPENAI_MODEL=
